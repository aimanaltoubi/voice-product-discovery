# ---------------------------------------------------------------------------
# Copy this file to `.env` at the REPO ROOT (next to this file) and fill in
# what you use. Every provider is swappable via these variables — no code
# changes needed. Real environment variables always win over .env values.
# ---------------------------------------------------------------------------

# ---- LLM (model-agnostic via LangChain init_chat_model) -------------------
# openai | anthropic | google_genai | ollama | mock
# "mock" = deterministic keyless heuristics for offline demos/CI.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Embeddings for the RAG index -----------------------------------------
# local  = Chroma's bundled ONNX MiniLM-L6-v2 (no key, downloads once ~80 MB)
# openai = text-embedding-3-small (uses OPENAI_API_KEY)
# hash   = test-only deterministic embedder (CI); NOT for real retrieval
EMBEDDINGS_PROVIDER=local

# ---- Whisper ASR -----------------------------------------------------------
# local  = faster-whisper on CPU (model downloads on first use)
# openai = Whisper API (whisper-1)
ASR_PROVIDER=local
WHISPER_MODEL_SIZE=base
OPENAI_ASR_MODEL=whisper-1

# ---- TTS -------------------------------------------------------------------
# edge   = Microsoft Edge neural voices via edge-tts (keyless)
# openai = OpenAI TTS
TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-US-AriaNeural
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# ---- web.search MCP tool ---------------------------------------------------
# ddg (keyless, default) | serper | brave | tavily
WEB_SEARCH_PROVIDER=ddg
# SERPER_API_KEY=
# BRAVE_API_KEY=
# TAVILY_API_KEY=
WEB_CACHE_TTL_SECONDS=180        # clamped to the spec's 60-300 s
WEB_RATE_LIMIT_PER_MIN=10
RAG_RATE_LIMIT_PER_MIN=60
# Comma-separated allowlist of retail/review domains; suffix match on netloc.
# WEB_ALLOWED_DOMAINS=amazon.com,walmart.com,target.com,homedepot.com,lowes.com,wirecutter.com,goodhousekeeping.com,consumerreports.org
# Strict = drop everything off-list even if that leaves zero results.
WEB_ALLOWLIST_STRICT=false

# ---- Retrieval / misc ------------------------------------------------------
RAG_TOP_K=8
# Minimum similarity (0-1) for a catalog row to count as a match. Below this the
# result set is emptied and the graph falls back to live web search instead of
# recommending an unrelated product. Tuned for the real Amazon-2020 curated
# slice + `local` embeddings; re-measure after re-slicing. 0 disables.
RAG_MIN_SCORE=0.45
CHROMA_COLLECTION=products
FRONTEND_ORIGIN=http://localhost:5173
